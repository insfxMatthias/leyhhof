# Caddy-Konfiguration für leyhhof.de (statische Seite aus dist/)
# HTTPS kommt automatisch über Let's Encrypt. Pfad unten anpassen.

www.leyhhof.de {
	redir https://leyhhof.de{uri} permanent
}

leyhhof.de {
	root * /var/www/leyhhof
	encode zstd gzip

	# Alte Jimdo-Seiten, die es nicht mehr gibt (konzept.md 3)
	redir /widerruf/ /kontakt/ permanent
	redir /widerruf /kontakt/ permanent
	redir /cookie-einstellungen/ /datenschutz/ permanent
	redir /cookie-einstellungen /datenschutz/ permanent

	# Jimdo-Seiten hatten einen Slash am Ende; ohne Slash → mit Slash
	@ohneSlash {
		not path /
		not path *.*
		not path */
	}
	redir @ohneSlash {path}/ permanent

	# Gebaute Assets sind inhaltsgehasht → lange cachen
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	try_files {path} {path}/index.html
	file_server

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404/index.html
		file_server
	}

	log {
		output file /var/log/caddy/leyhhof.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
