---
/** Einzelnes Angebot (z. B. Pferdegeburtstag) als Karte mit Icon, Titel, Text 1:1. */
import Foto from './Foto.astro';
import Icon from './Icon.astro';

interface Props {
  icon: string;
  titel: string;
  text: string;
  farbe: 'wiese' | 'sonne' | 'himmel';
  ebene?: 2 | 3;
  bild?: { src: ImageMetadata; alt: string };
}
const { icon, titel, text, farbe, ebene = 2, bild } = Astro.props;
const Titel = `h${ebene}` as 'h2' | 'h3';
const iconBg = { wiese: 'bg-wiese text-white', sonne: 'bg-sonne text-erde', himmel: 'bg-himmel text-erde' }[farbe];
---

<article class="flex flex-col overflow-hidden rounded-karte bg-white shadow-karte">
  {bild && (
    <Foto src={bild.src} alt={bild.alt} width={640} class="aspect-[3/2] w-full object-cover" />
  )}
  <div class:list={['flex flex-1 flex-col p-6 sm:p-7', bild && '-mt-8']}>
  <span class:list={['inline-flex w-fit rounded-full border-4 border-white p-3', iconBg]}><Icon name={icon} class="size-8" /></span>
  <Titel class="mt-4 text-2xl">{titel}</Titel>
  <p class="mt-3">{text}</p>
  </div>
</article>
