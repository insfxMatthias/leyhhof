---
import hof from '../content/hof.json';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import logo from '../images/leyhlogo.png';
const jahr = new Date().getFullYear();
---

<footer class="bg-erde text-creme">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <Image src={logo} alt="Logo Leyh Hof – Erlebnisbauernhof" width={96} height={125} layout="fixed" format="webp" class="h-28 w-auto" />
      <p class="mt-4 font-headline text-xl font-bold">{hof.name}</p>
      <address class="mt-4 not-italic leading-relaxed">
        {hof.adresse.strasse}<br />
        {hof.adresse.plz} {hof.adresse.ort}<br />
        <a href={`tel:${hof.telefonLink}`} class="text-creme decoration-sonne/60 hover:decoration-sonne">Tel.: {hof.telefon}</a><br />
        <a href={`mailto:${hof.email}`} class="text-creme decoration-sonne/60 hover:decoration-sonne">{hof.email}</a>
      </address>
    </div>
    <nav aria-label="Fußnavigation">
      <p class="font-headline text-lg font-semibold text-sonne">Seiten</p>
      <ul class="mt-3 space-y-1.5">
        {hof.navigation.map((n) => (
          <li><a href={n.href} class="text-creme decoration-sonne/60 hover:decoration-sonne">{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div>
      <p class="font-headline text-lg font-semibold text-sonne">Folgt uns</p>
      <a href={hof.instagram.url} rel="noopener" class="mt-3 inline-flex items-center gap-2 text-creme decoration-sonne/60 hover:decoration-sonne">
        <Icon name="instagram" class="size-6" />
        {hof.instagram.handle}
      </a>
      <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {hof.footerNavigation.map((n) => (
          <li><a href={n.href} class="text-creme decoration-sonne/60 hover:decoration-sonne">{n.label}</a></li>
        ))}
      </ul>
      <p class="mt-3 text-sm text-creme/80">© {jahr} {hof.name}</p>
    </div>
  </div>
</footer>
