---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const seite = await getEntry('seiten', 'datenschutz');
if (!seite) throw new Error('datenschutz.md fehlt');
const { Content } = await render(seite);
---

<Base title={seite.data.title} description={seite.data.description}>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14" aria-labelledby="seite-titel">
    <h1 id="seite-titel">{seite.data.h1}</h1>
    <div class="prose-hof mt-8">
      <Content />
    </div>
  </section>
</Base>
