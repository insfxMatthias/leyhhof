---
import '../styles/global.css';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-standard-normal.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import hof from '../content/hof.json';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogBild = new URL('/og.jpg', Astro.site);

// LocalBusiness-Daten für Google (konzept.md 4.3)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#hof', Astro.site).href,
  name: hof.name,
  url: Astro.site?.href,
  telephone: hof.telefonLink,
  email: hof.email,
  image: ogBild.href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: hof.adresse.strasse,
    postalCode: hof.adresse.plz,
    addressLocality: hof.adresse.ort,
    addressCountry: 'DE',
  },
  geo: { '@type': 'GeoCoordinates', latitude: hof.geo.lat, longitude: hof.geo.lon },
  openingHours: 'nach Vereinbarung',
  sameAs: [hof.instagram.url],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" as="font" type="font/woff2" href={frauncesUrl} crossorigin />
    <meta name="theme-color" content="#fff8ec" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={hof.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogBild} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-dvh bg-creme font-sans text-erde antialiased">
    <a href="#inhalt" class="skip-link">Zum Inhalt springen</a>
    <Nav />
    <main id="inhalt" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
